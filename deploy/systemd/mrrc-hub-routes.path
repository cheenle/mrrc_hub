# Trigger on the two things that decide what the routes are: the registry, and the certificates the
# instances registered. PathModified covers a re-enrolment (the same file, new content), PathChanged
# covers a certificate appearing or being removed, and DirectoryNotEmpty makes sure a first file
# landing in an empty directory is seen.
[Unit]
Description=MRRC hub: watch the registry and instance certificates

[Path]
PathChanged=/etc/mrrc-hub/instances.tsv
PathModified=/etc/mrrc-hub/instances.tsv
PathChanged=/etc/mrrc-hub/instance-certs
PathModified=/etc/mrrc-hub/instance-certs
DirectoryNotEmpty=/etc/mrrc-hub/instance-certs
Unit=mrrc-hub-routes.service

[Install]
WantedBy=multi-user.target
